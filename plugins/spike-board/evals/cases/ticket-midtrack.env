# ticket-midtrack
MARKER_STATE=off
NEEDS=chain
PROMPT=$(cat <<'PROMPT_EOF'
Use the spike-board:spike-ticket skill. I want to make a spike ticket.
PROMPT_EOF
)
MUST=$(cat <<'MUST_EOF'
Is this spike the \*\*next step on that path\*\*, or \*\*something new\*\*\?
/spike-board:spike-refine {{NEXT_KEY}}
Run `/spike-board:spike-pivot`
where it sits against your current queue is your mentor's call at refinement
MUST_EOF
)
MUST_NOT=$(cat <<'MUST_NOT_EOF'
[Oo]perator marker
[Ll]oading (your|their) board
current user is the mentee
Isaiah|Austin|Andrew
queues behind
blocked by SCRUM-22 so
MUST_NOT_EOF
)
